## Backend environment variables (DO NOT COMMIT your real .env)
#
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
#
# MongoDB Atlas connection string (example format):
# MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.btxwbh.mongodb.net/?appName=Cluster0
MONGODB_URI=

# Optional (enables OpenAI-based transcription/summarization/preference analysis)
OPENAI_API_KEY=

# Optional (make Mongo connection fail faster/slower)
# MONGODB_SERVER_SELECTION_TIMEOUT_MS=2000
# MONGODB_CONNECT_TIMEOUT_MS=2000
# MONGODB_SOCKET_TIMEOUT_MS=2000
